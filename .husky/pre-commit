#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run linting
echo "🔍 Running linter..."
npm run lint || exit 1

# Check formatting
echo "✨ Checking code formatting..."
npm run format:check || exit 1

# Run type checking
echo "🔎 Running type check..."
npm run type-check || exit 1

# Run tests
echo "🧪 Running tests..."
npm test -- --passWithNoTests || exit 1

echo "✅ Pre-commit checks passed!"

